---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../config/i18n";
import { withBase } from "../utils/with-base";

interface Props {
  post: CollectionEntry<"blog"> | CollectionEntry<"blogEn">;
  locale?: Locale;
}

const { post, locale = "zh" } = Astro.props;
const articleHref = locale === "en" ? `/en/blog/${post.id}/` : `/blog/${post.id}/`;
const dateLocale = locale === "en" ? "en-US" : "zh-CN";
const readMore = locale === "en" ? "Read the article" : "阅读全文";
---

<article class="post-card glass">
  <div class="meta">
    <span>{post.data.category}</span>
    <span>{post.data.publishedAt.toLocaleDateString(dateLocale)}</span>
    <span>{post.data.readingTime}</span>
  </div>
  <div>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
  </div>
  <div class="tags">
    {post.data.tags.slice(0, 3).map((tag) => (
      <span class="tag">#{tag}</span>
    ))}
  </div>
  <a class="post-link" href={withBase(articleHref)}>
    {readMore}
  </a>
</article>
