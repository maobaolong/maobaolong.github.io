---
import site from "../config/site.json";
import { siteText, type Locale } from "../config/i18n";
import { withBase } from "../utils/with-base";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = siteText[locale];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner glass">
      <div class="footer-copy">
        <strong>{text.siteName}</strong>
        <div>{text.tagline} · © {year}</div>
      </div>
      <div class="footer-links">
        <a href={site.githubProfile} target="_blank" rel="noreferrer">GitHub</a>
        <a href={withBase(locale === "en" ? "/en/message-board/" : "/message-board/")}>{text.footerGuestbook}</a>
        <a href={withBase(locale === "en" ? "/en/admin/" : "/admin/")}>{text.footerAdmin}</a>
      </div>
    </div>
  </div>
</footer>
