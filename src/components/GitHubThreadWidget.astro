---
import site from "../config/site.json";
import type { Locale } from "../config/i18n";
import { withBase } from "../utils/with-base";

interface Props {
  issueNumber: number;
  threadKey: string;
  kind: "article" | "guestbook";
  locale?: Locale;
}

const { issueNumber, threadKey, kind, locale = "zh" } = Astro.props;
const [owner, repo] = site.githubRepo.split("/");
const loadingTitle = locale === "en" ? (kind === "guestbook" ? "Guestbook" : "Comments and Reactions") : (kind === "guestbook" ? "留言板" : "评论与点赞");
const loadingCopy = locale === "en" ? "Loading discussion..." : "正在加载互动内容...";
---

<section
  class="github-thread glass"
  data-github-thread
  data-owner={owner}
  data-repo={repo}
  data-client-id={site.githubAuth.clientId}
  data-scope={site.githubAuth.scope}
  data-auth-base-url={site.githubAuth.authBaseUrl}
  data-issue-number={issueNumber}
  data-thread-key={threadKey}
  data-kind={kind}
  data-locale={locale}
>
  <div class="github-thread__loading">
    <span class="chip">GitHub</span>
    <h3>{loadingTitle}</h3>
    <p>{loadingCopy}</p>
  </div>
</section>

<script type="module" src={withBase("/scripts/github-thread-widget.js")}></script>
