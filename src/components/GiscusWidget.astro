---
import site from "../config/site.json";

interface Props {
  mode?: "pathname" | "specific";
  term?: string;
}

const { mode = "pathname", term = "" } = Astro.props;

const giscus = site.giscus;
const isConfigured =
  Boolean(giscus.repo) &&
  !giscus.repoId.includes("REPLACE_ME") &&
  !giscus.categoryId.includes("REPLACE_ME");
---

{isConfigured ? (
  <section class="glass guestbook-card">
    <script
      src="https://giscus.app/client.js"
      data-repo={giscus.repo}
      data-repo-id={giscus.repoId}
      data-category={giscus.category}
      data-category-id={giscus.categoryId}
      data-mapping={mode}
      data-term={mode === "specific" ? term : undefined}
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme={giscus.theme}
      data-lang={giscus.lang}
      crossorigin="anonymous"
      async
    ></script>
  </section>
) : (
  <div class="notice">
    评论系统还没接上。请先在 <code>src/config/site.json</code> 里补上 giscus 的
    <code>repoId</code> 和 <code>categoryId</code>，再重新部署站点。
  </div>
)}
