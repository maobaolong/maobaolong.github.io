---
import { withBase } from "../utils/with-base";

const target = withBase("/en/blog/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <title>Opening Maobaolong Engineering Blog…</title>
    <script is:inline define:vars={{ target }}>
      localStorage.setItem("maobaolong:preferred-language", "en");
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Opening the <a href={target}>English engineering blog</a>…</p>
  </body>
</html>
